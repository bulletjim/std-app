{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@backend/*" : ["./src/backend/*"],
      "@frontend/*": ["./src/frontend/*"],
      "@test/*": ["./src/tests/*"]
    }

  },
  "include": ["src"]
}
